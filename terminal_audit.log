class FakeKosDB:
    def __init__(self): self.tables = {}; self.queries = []
    def list_tables(self): return list(self.tables.keys())
    def execute(self, sql):
        self.queries.append(sql)
        if sql.startswith("CREATE TABLE"):
            t = sql.split()[2]
            self.tables[t] = []
            return "OK"
        if sql.startswith("INSERT"):
            t = sql.split("INTO")[1].split()[0]
            self.tables[t].append({"id": "fake-id", "title": "Hello", "slug": "hello", "content": "world", "status": "draft", "author_id": "", "created_at": "now", "updated_at": "now", "is_deleted": "0"})
            return "OK"
        if sql.startswith("UPDATE"):
            return "OK"
        return "OK"
    def query(self, sql):
        self.queries.append(sql)
        if "COUNT" in sql:
            return {"rows": [{"c": 0}]}
        if "SELECT * FROM pages WHERE id=" in sql:
            return {"rows": [{"id": "fake-id", "title": "Hello", "slug": "hello", "content": "world", "status": "draft", "author_id": "", "created_at": "now", "updated_at": "now", "is_deleted": "0"}]}
        return {"rows": []}

