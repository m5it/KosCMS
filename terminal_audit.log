print('=== CHECKING FOR JAVASCRIPT ===')
if '<script' in html.lower():
    print('WARNING: Found <script> tag in HTML!')
    # Extract script
    import re
    scripts = re.findall(r'<script.*?</script>', html, re.DOTALL | re.IGNORECASE)
    for s in scripts[:3]:
        print(f'Script: {s[:200]}...')
else:
    print('No JavaScript found in HTML')
