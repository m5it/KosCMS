async def test_versioning():
    print('Testing VersionManager...')
    manager = VersionManager(max_versions=5)
    
    # Create versions
    v1 = await manager.create_version(
        'post-1', 'post',
        {'title': 'Hello', 'content': 'World'},
        user_id='u1', username='Alice', comment='Initial version'
    )
    print(f'✓ Created version {v1.version_number}')
    
    v2 = await manager.create_version(
        'post-1', 'post',
        {'title': 'Hello Updated', 'content': 'World!'},
        user_id='u2', username='Bob', comment='Updated title'
    )
    print(f'✓ Created version {v2.version_number}')
    
    # List versions
    versions = await manager.list_versions('post-1', 'post')
    print(f'✓ Listed {len(versions)} versions')
    
    # Compare versions
    diff = await manager.compare_versions(v1.version_id, v2.version_id, 'content')
    print(f'✓ Diff generated: {len(diff["unified_diff"])} chars')
    
    # Rollback
    v3 = await manager.rollback('post-1', 'post', 1, user_id='u3', username='Carol')
    print(f'✓ Rollback created version {v3.version_number}')
    
    # Audit trail
    trail = await manager.get_audit_trail('post-1', 'post')
    print(f'✓ Audit trail: {len(trail)} entries')
    
    print('\nVersioning system verified!')

asyncio.run(test_versioning())
