{
  "database": {
    "url": "sqlite:///webcms.db"
  },
  "server": {
    "host": "0.0.0.0",
    "port": 8000
  },
  "security": {
    "csp": {
      "default_src": ["'self'"],
      "script_src": ["'self'", "'unsafe-inline'"],
      "style_src": ["'self'", "'unsafe-inline'"],
      "img_src": ["'self'", "data:", "https:"],
      "frame_ancestors": ["'self'"]
    },
    "hsts": false
  }
}